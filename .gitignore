# Dependencies
node_modules/

# Build output (published artifact is built in CI or before npm publish)
dist/

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secrets (this repo should not need runtime env; ignore if added locally)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
*credentials*.json
service-account*.json

# Test & coverage
coverage/
.nyc_output

# Caches
.cache/
.eslintcache
.npm

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE (optional local settings stay untracked)
.idea/
*.swp
*~

# Cursor local state
.cursor/

# Optional local overrides (machine-specific paths, secrets)
.private/

# Accidental large exports from Lab tooling (core is code-only, not corpus dumps)
generated-data/
*.csv
!tests/fixtures/**/*.csv

# Pack tarballs
*.tgz
